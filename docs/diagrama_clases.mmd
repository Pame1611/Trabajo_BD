classDiagram
    direction TB
    class Usuario {
        <<abstract>>
        -String id
        -String dni
        -String passwordHash
        -String nombreCompleto
        +getRol() Rol*
        +puedeOperarCaja() boolean*
        +verificarPassword(String) boolean
    }
    class Empleado {
        +getRol() Rol
        +puedeOperarCaja() boolean
    }
    class Administrador {
        +getRol() Rol
        +puedeOperarCaja() boolean
    }
    class Tarifa {
        -int id
        -String tipoVehiculo
        -double precioHora
        -double tarifaMensual
        +actualizarPrecios(double, double)
        +getPrecioMinuto() double
    }
    class Cliente {
        -String dni
        -String nombreCompleto
        -String telefono
        +actualizar(String, String)
    }
    class Venta {
        -Cliente cliente
        -Alquiler alquiler
        -Pago pago
        +getMonto() double
    }
    class Marca {
        -int id
        -String nombre
    }
    class Modelo {
        -int id
        -String nombre
        -Marca marca
        -Tarifa tipoVehiculo
        +getDescripcion() String
    }
    class TipoAlquiler {
        <<enumeration>>
        POR_HORA
        MENSUAL
    }
    class AlquilerMensual {
        +DESCUENTO = 0.10
        -LocalDateTime fechaFin
        +calcularMonto(LocalDateTime) double
        +calcularSubtotal(LocalDateTime) double
        +mesesHasta(LocalDateTime) int
    }
    class TurnoCaja {
        -LocalDateTime fechaApertura
        -LocalDateTime fechaCierre
        -EstadoTurno estado
        -Double efectivoDeclarado
        -Double diferenciaCaja
        +cerrar(fecha, declarado, efectivoSistema)
        +estaAbierto() boolean
    }
    class Alquiler {
        -String placa
        -String codigoBarras
        -LocalDateTime horaEntrada
        -LocalDateTime horaSalida
        -EstadoTicket estado
        -Cliente cliente
        -Usuario empleado
        -Modelo modelo
        +calcularMonto(LocalDateTime) double
        +calcularSubtotal(LocalDateTime) double
        +calcularDescuento(LocalDateTime) double
        +getTipoAlquiler() TipoAlquiler
        +registrarSalida(LocalDateTime)
        +anular()
    }
    class Pago {
        -double montoTotal
        -MetodoPago metodoPago
        -LocalDateTime creadoEn
        +cambiarMetodoPago(MetodoPago)
    }
    class TicketImprimible {
        <<abstract>>
        +generar() String
        #encabezado() String*
        #cuerpo() String*
        #pie() String*
    }
    class TicketEntrada
    class TicketSalida
    class Impresora {
        <<interface>>
        +conectar()
        +imprimir(String)
    }
    class ImpresoraTermicaConsola
    class ImpresoraArchivo
    class MenuBase {
        <<abstract>>
        +mostrar()
        #getOpciones() List*
        #atenderOpcion(int)*
        #alSeleccionarVehiculo(Alquiler)
    }
    class MenuEmpleado
    class MenuAdministrador
    class CocheraException
    class ValidacionException
    class AccesoDenegadoException

    Usuario <|-- Empleado
    Usuario <|-- Administrador
    Empleado "1" --> "*" TurnoCaja : abre
    Alquiler "*" --> "1" Tarifa : tipo de vehiculo
    Alquiler <|-- AlquilerMensual : redefine calcularMonto()
    Alquiler "*" --> "1" Cliente : cliente_dni
    Alquiler "*" --> "1" Modelo : modelo_id
    Alquiler ..> TipoAlquiler
    Marca "1" --> "*" Modelo : tiene
    Modelo "*" --> "0..1" Tarifa : tipo de vehiculo
    Cliente "1" --> "*" Venta : compra
    Venta "1" --> "1" Alquiler
    Venta "1" --> "1" Pago
    Pago "1" --> "1" Alquiler : liquida
    Pago "*" --> "1" TurnoCaja : turno de quien cobra
    TicketImprimible <|-- TicketEntrada
    TicketImprimible <|-- TicketSalida
    TicketEntrada --> Alquiler
    TicketSalida --> Pago
    Impresora <|.. ImpresoraTermicaConsola
    Impresora <|.. ImpresoraArchivo
    MenuBase <|-- MenuEmpleado
    MenuBase <|-- MenuAdministrador
    CocheraException <|-- ValidacionException
    CocheraException <|-- AccesoDenegadoException
